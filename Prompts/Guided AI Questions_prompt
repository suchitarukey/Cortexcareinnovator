def ask_ai(question, context):
    prompt = f"""
    You are a healthcare analytics expert.

    Context:
    {context}

    Question:
    {question}

    Answer:
    - In simple business language
    - Give clear explanation
    - Include actionable recommendation
    """

    query = f"""
    SELECT SNOWFLAKE.CORTEX.COMPLETE(
        'mistral-large',
        $$ {prompt} $$
    ) AS RESPONSE;
    """

    return session.sql(query).collect()[0]["RESPONSE"]

