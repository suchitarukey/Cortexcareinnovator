def styled_df(df_in, revenue_col=None):
    if revenue_col and revenue_col in df_in.columns:
        col = df_in[revenue_col]
        vmin, vmax = col.min(), col.max()
        rng = vmax - vmin if vmax != vmin else 1
        def color_row(row):
            val = row[revenue_col]
            intensity = int(40 + 60 * (val - vmin) / rng)
            bg = f"rgba(214, 39, 40, {intensity / 100})"
            return [f"background-color: {bg}; color: white" if c == revenue_col else "" for c in row.index]
        return df_in.style.apply(color_row, axis=1).format({revenue_col: "${:,.0f}"})
    return df_in

def plotly_bar(data, x, y, title, color=None, horizontal=False, text_fmt=None):
    orient = "h" if horizontal else "v"
    kw = dict(orientation=orient, text=y if text_fmt else None, title=title)
    if horizontal: kw.update(x=y, y=x)
    else: kw.update(x=x, y=y)
    if color: kw["color"] = y; kw["color_continuous_scale"] = color
    else: kw["color_discrete_sequence"] = [COLORS["blue"]]
    fig = px.bar(data, **kw)
    if text_fmt: fig.update_traces(texttemplate=text_fmt, textposition="outside")
    fig.update_layout(**PLOT_LAYOUT, coloraxis_showscale=False, height=420, xaxis_title="", yaxis_title="")
    return fig

def plotly_donut(labels, values, title, colors=None):
    fig = px.pie(pd.DataFrame({"Label":labels,"Count":values}), names="Label", values="Count",
                 hole=0.5, title=title, color_discrete_sequence=colors or [COLORS["green"],COLORS["red"]])
    fig.update_traces(textinfo="label+percent+value", textfont_size=11)
    fig.update_layout(height=400, **PLOT_LAYOUT)
    return fig

def premium_provider_chart(data, title, bar_color, avg_rate):
    fig = go.Figure()
    fig.add_trace(go.Bar(
        y=data["PROVIDER_ID"], x=data["RECAPTURE_RATE"],
        orientation="h", marker=dict(color=bar_color, line=dict(width=0)),
        text=[f"{v:.1f}%" for v in data["RECAPTURE_RATE"]],
        textposition="outside", textfont=dict(size=11, color="#2c3e50"),
        hovertemplate="<b>%{y}</b><br>Recapture Rate: %{x:.1f}%<br>Recaptured: %{customdata[0]} / %{customdata[1]} HCCs<extra></extra>",
        customdata=list(zip(data["RECAPTURED"].astype(int), data["TOTAL"].astype(int))),
    ))
    fig.add_vline(x=avg_rate, line_dash="dash", line_color="#7f8c8d", line_width=2,
                  annotation_text=f"Avg: {avg_rate:.1f}%", annotation_position="top", annotation_font=dict(size=11, color="#7f8c8d"))
    fig.update_layout(
        title=dict(text=title, font=dict(size=14)),
        xaxis=dict(title="Recapture Rate (%)", range=[0, max(data["RECAPTURE_RATE"].max() * 1.25, avg_rate * 1.3)],
                   showgrid=True, gridcolor="rgba(0,0,0,0.05)", zeroline=False),
        yaxis=dict(title="", autorange="reversed", tickfont=dict(size=10)),
        height=480, bargap=0.3,
        plot_bgcolor="rgba(0,0,0,0)", paper_bgcolor="rgba(0,0,0,0)",
        margin=dict(l=10, r=60, t=50, b=40),
    )
    return fig

