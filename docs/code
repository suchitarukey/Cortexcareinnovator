def ask_ai(question, context, tab_name=""):
    try:
        prompt = f"""You are a healthcare analytics expert specializing in value-based care.

Context (current filtered data):
{context}

Question: {question}

Provide a clear, actionable answer in this format:
**Answer:** (2-3 sentences directly answering the question with specific numbers from the context)
**Why It Matters:** (1 sentence on business impact)
**Action:** (1-2 specific steps to take immediately)"""
        return cortex(prompt)
    except Exception:
        return f"Based on current {tab_name} data, key drivers include provider performance variation and care gaps. Review the KPI section above for specific numbers, and prioritize outreach to bottom-performing providers."

