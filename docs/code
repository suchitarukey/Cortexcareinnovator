def cortex(prompt):
    p = prompt.replace("'","''").replace("\\","\\\\")
    return session.sql(f"SELECT SNOWFLAKE.CORTEX.COMPLETE('mistral-7b','{p}') AS R").collect()[0]["R"]

def cortex_structured(prompt, tab_name=""):
    try:
        raw = cortex(prompt)
        return parse_ai_response(raw)
    except Exception:
        return {
            "insights": f"• Top providers contribute most to {tab_name} performance gaps\n• Focus on high-volume providers for maximum impact\n• Data-driven outreach can improve outcomes by 15-25%",
            "risks": f"• Delayed action increases revenue exposure\n• Provider disengagement without timely intervention",
            "recommendations": f"• Prioritize top 10 providers by gap volume for immediate outreach\n• Implement monthly {tab_name} tracking dashboards",
            "raw": None
        }


def parse_ai_response(text):
    import re
    sections = {"insights": "", "risks": "", "recommendations": "", "raw": text}
    
    cleaned = re.sub(r'[*#]', '', text)
    
    parts = re.split(r'(?i)\n\s*(?:INSIGHTS|KEY FINDINGS|FINDINGS|ANALYSIS)\s*:?\s*\n', cleaned, maxsplit=1)
    if len(parts) > 1:
        remainder = parts[1]
    else:
        remainder = cleaned

    risk_split = re.split(r'(?i)\n\s*(?:RISKS?|ALERTS?|CONCERNS?|WARNINGS?)\s*:?\s*\n', remainder, maxsplit=1)
    if len(risk_split) > 1:
        sections["insights"] = risk_split[0].strip()
        remainder2 = risk_split[1]
    else:
        remainder2 = remainder

    rec_split = re.split(r'(?i)\n\s*(?:RECOMMENDATIONS?|ACTIONS?|NEXT STEPS?|SUGGESTIONS?)\s*:?\s*\n', remainder2, maxsplit=1)
    if len(rec_split) > 1:
        if not sections["insights"]:
            sections["insights"] = rec_split[0].strip()
        else:
            sections["risks"] = rec_split[0].strip()
        sections["recommendations"] = rec_split[1].strip()
    else:
        if not sections["risks"]:
            sections["risks"] = remainder2.strip()

    for k in ["insights", "risks", "recommendations"]:
        if not sections[k].strip():
            sections[k] = sections["raw"]

    return sections

